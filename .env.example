# Copy to .env and fill in only what you use. Never commit .env.

# ---------------------------------------------------------------------------
# Language model. Switch here, with --provider/--model on the CLI, or live in the UI.
#   ollama      local, free            (needs `ollama serve`)
#   groq        hosted, free tier      GROQ_API_KEY
#   openai      hosted, paid           OPENAI_API_KEY
#   claude      hosted, paid           ANTHROPIC_API_KEY
#   gemini      hosted, free tier      GEMINI_API_KEY
#   openrouter  one key, many models   OPENROUTER_API_KEY  (e.g. anthropic/..., openai/..., qwen/...)
#   custom      any OpenAI-compatible server (LM Studio, vLLM, Together, ...)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter
# Tested pick (README "Model comparison"). Offline: LLM_PROVIDER=ollama and LLM_MODEL= (empty = qwen3:4b).
LLM_MODEL=anthropic/claude-haiku-5.5

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# custom provider, e.g. LM Studio: http://localhost:1234/v1 (key optional)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Database (required): Supabase, or any Postgres.
# Supabase: Project -> Connect -> "Session pooler" connection string, with your DB password:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The app uses the 'public' schema: tables are created and seeded with fictional data on
# first run (Reset schedule re-seeds). Tests and evals each create a private schema
# (test_xxxx / eval_xxxx) in the same database and drop it afterwards.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Optional: run tests against a different database instead of DATABASE_URL.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Sign-in (optional). With these set, patients and staff sign in with Supabase Auth.
# Supabase: Project Settings -> API: Project URL and the anon / publishable key (safe for browsers).
# Also put the same two values in frontend/.env.local as NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated emails allowed on the staff dashboard
STAFF_EMAILS=

# ---------------------------------------------------------------------------
# Router (decides which agent handles each message):
#   llm    natural-language router; model set below (recommended: Jev Router on OpenRouter)
#   jev    TypeSafe's Jev API directly (pip install typesafe-sdk, TYPESAFE_API_KEY)
#   rules  keyword rules only (offline; also the automatic backup for llm and jev)
# ---------------------------------------------------------------------------
DECIDER=llm
DECIDER_PROVIDER=openrouter
DECIDER_MODEL=typesafe/jev-router
TYPESAFE_API_KEY=

# Pin the clinic's "today" for reproducible demos (optional)
# CLINIC_TODAY=2026-11-20

# Reminder agent (background, inside the API). Email = simulated outbox unless SMTP_HOST is set
# (e.g. Mailpit: SMTP_HOST=localhost SMTP_PORT=1025). SMS is always simulated. Calendar invites are real .ics files.
REMINDERS_ENABLED=1
REMINDER_INTERVAL_SECONDS=60
REMINDER_WINDOW_HOURS=48
SMTP_HOST=
SMTP_PORT=1025
# Real email (optional). Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_STARTTLS=1,
# SMTP_USER = your Gmail address, SMTP_PASSWORD = a Google *app password* (not your normal password).
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=
MAIL_FROM=
# (SMTP_STARTTLS is automatic on port 587)
# Real (non-fictional) emails the app may store and send to, comma-separated. Use only your own address.
# Every other patient contact must be fictional (555-01xx phones, example.com / .test emails).
REAL_CONTACT_ALLOWLIST=

# ---------------------------------------------------------------------------
# Advanced (optional; defaults shown)
# ---------------------------------------------------------------------------
# MAX_STEPS=8                   agent steps per turn before it stops
# MAX_INVALID=3                 invalid proposals in a row before it stops
# EVIDENCE_DIR=evidence         where run records (JSON) are saved
# INSURANCE_CHECK_DELAY=1.5     seconds the simulated insurance check takes
# TYPESAFE_BASE_URL=            Jev API base URL (only with DECIDER=jev)
